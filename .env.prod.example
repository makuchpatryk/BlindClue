# EC2 Production Environment Variables
# Copy to .env.prod and fill in with your values
# Then source before running docker compose: source .env.prod

# Domain or IP of your EC2 instance
VITE_URL="http://your-ec2-ip-or-domain.com"

# Backend configuration (same as frontend URL)
CORS_ORIGIN="$VITE_URL"

# Frontend configuration (for docker compose build args)
VITE_API_URL="$VITE_URL/api"
VITE_SOCKET_URL="$VITE_URL"

# Optional: For HTTPS (after setting up with Certbot)
# VITE_URL="https://your-ec2-ip-or-domain.com"
# CORS_ORIGIN="$VITE_URL"
# VITE_API_URL="$VITE_URL"
# VITE_SOCKET_URL="$VITE_URL"
